#!/usr/bin/env bash
# Blocks secrets from entering git history. Used by the pre-commit and pre-push hooks.
#
#   .githooks/check-secrets staged          # what is about to be committed
#   .githooks/check-secrets range A..B      # commits about to be pushed
#
# Findings name the file and the kind of match, never the secret itself.
set -euo pipefail
export LC_ALL=C

GREP=/usr/bin/grep # bypass any shell aliases/functions
root="$(git rev-parse --show-toplevel)"
tmp="$(mktemp -d)"
chmod 700 "$tmp"
trap 'rm -rf "$tmp"' EXIT

mode="${1:-staged}"
case "$mode" in
  staged)
    git diff --cached --no-color -U0 --diff-filter=ACMR >"$tmp/diff"
    git diff --cached --name-only --diff-filter=ACMR >"$tmp/files"
    ;;
  range)
    range="${2:?usage: check-secrets range <rev-range>}"
    git log --no-color -p -U0 --format='commit %H' $range >"$tmp/diff"
    git log --format= --name-only --diff-filter=ACMR $range | sort -u >"$tmp/files"
    ;;
  *)
    echo "usage: check-secrets staged | range <rev-range>" >&2
    exit 2
    ;;
esac

findings=0
report() {
  echo "  ✗ $1" >&2
  findings=$((findings + 1))
}

# 1. Files that should never be committed.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  base="${f##*/}"
  case "$base" in
    .env.example) ;;
    .env | .env.*) report "$f: environment file (keep secrets in the untracked .env)" ;;
    *.pem | *.key | *.p12 | *.pfx | id_rsa* | id_ed25519* | credentials.json | service-account*.json)
      report "$f: key or credentials file" ;;
  esac
done <"$tmp/files"

# 2. Added lines, as "path<TAB>content", so findings can name the file.
#    Deliberately public values (.githooks/secrets-allowlist) are masked first.
"$GREP" -v -e '^#' -e '^$' "$root/.githooks/secrets-allowlist" 2>/dev/null >"$tmp/allow" || true
awk -v allowfile="$tmp/allow" '
  BEGIN { while ((getline a < allowfile) > 0) allow[++n] = a }
  /^\+\+\+ / { path = substr($0, 5); sub(/^b\//, "", path); next }
  /^\+/ {
    line = substr($0, 2)
    for (i = 1; i <= n; i++) {
      while ((p = index(line, allow[i])) > 0)
        line = substr(line, 1, p - 1) "<public>" substr(line, p + length(allow[i]))
    }
    print path "\t" line
  }
' "$tmp/diff" >"$tmp/added"

check() { # <label> <extended regex>
  "$GREP" -E -- "$2" "$tmp/added" | cut -f1 | sort -u | while IFS= read -r f; do
    echo "$f: $1"
  done
}
{
  check "TypeSafe API key" 'apikey_[A-Za-z0-9_]{16,}'
  check "AWS access key" 'AKIA[0-9A-Z]{16}'
  check "private key block" '-----BEGIN [A-Z ]*PRIVATE KEY'
  check "GitHub token" 'gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{20,}'
  check "OpenAI/Anthropic key" 'sk-(ant-)?[A-Za-z0-9_-]{20,}'
  check "Slack token" 'xox[abprs]-[A-Za-z0-9-]{10,}'
  check "Google API key" 'AIza[0-9A-Za-z_-]{35}'
  # NAME = "literal" / NAME: 'literal' / NAME=value<end of line> (code expressions don't match)
  check "secret variable with a value" '(^|[^A-Za-z0-9_])[A-Z0-9_]*(API_KEY|SECRET|TOKEN|PASSWORD)[A-Z0-9_]*[[:space:]]*[=:][[:space:]]*(["'"'"'][^"'"'"'[:space:]]{12,}["'"'"']|[A-Za-z0-9_/+.=-]{12,}[[:space:]]*$)'
} >"$tmp/pattern-hits" || true
while IFS= read -r line; do report "$line"; done <"$tmp/pattern-hits"

# 3. Exact values from the local .env (catches secrets of any format).
if [ -f "$root/.env" ]; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '' | \#*) continue ;; esac
    name="${line%%=*}"
    value="${line#*=}"
    value="${value%\"}"; value="${value#\"}"; value="${value%\'}"; value="${value#\'}"
    [ "${#value}" -lt 12 ] && continue
    # Only secret-named variables, or URLs carrying credentials (scheme://user:pass@host).
    case "$name" in
      *API_KEY* | *SECRET* | *TOKEN* | *PASSWORD* | *PRIVATE*) ;;
      *) printf '%s' "$value" | "$GREP" -qE '^[a-z+]+://[^/:@]+:[^/@]+@' || continue ;;
    esac
    "$GREP" -qxF -- "$value" "$tmp/allow" && continue
    printf '%s\n' "$value" >"$tmp/needle"
    if "$GREP" -qFf "$tmp/needle" "$tmp/added"; then
      for f in $("$GREP" -Ff "$tmp/needle" "$tmp/added" | cut -f1 | sort -u); do
        report "$f: contains the value of $name from your .env"
      done
    fi
  done <"$root/.env"
fi

if [ "$findings" -gt 0 ]; then
  echo "" >&2
  echo "Blocked: $findings possible secret(s) ($mode). Remove them, or move them to .env (untracked)." >&2
  echo "False positive? Adjust .githooks/check-secrets rather than bypassing with --no-verify." >&2
  exit 1
fi
