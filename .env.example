# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Key merchants send as x-api-key. Required in Docker/production (min 24 chars):
#   openssl rand -hex 24
# Left empty, local `npm run dev` uses the public development key.
VIGIL_API_KEY=
DATABASE_URL=postgres://vigil:vigil@localhost:5432/vigil
REDIS_URL=redis://localhost:6379
PORT=8080
FEATURE_STORE=redis
# passthrough | rules | xgboost | jev | jev_rules (jev* need TYPESAFE_API_KEY;
# xgboost needs a trained model: uv run vigil-train)
SCORING_STRATEGY=rules
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2000
JEV_MAX_RETRIES=1
