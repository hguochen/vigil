# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

VIGIL_API_KEY=dev-local-key
DATABASE_URL=postgres://vigil:vigil@localhost:5432/vigil
REDIS_URL=redis://localhost:6379
PORT=8080
FEATURE_STORE=redis
# passthrough | rules | jev | jev_rules (jev* need TYPESAFE_API_KEY)
SCORING_STRATEGY=rules
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2000
JEV_MAX_RETRIES=1
